import java.util.*;
 
public class Main
{
        public static void main(String[] args)
        {
                HashSet<Integer> set = new HashSet<>();
                Scanner sc = new Scanner(System.in);
                int c = 0;
                for(int i = 0;i<4;i++)
                {
                        int a = sc.nextInt();
                        if(!set.add(a)) c++;
                }
                System.out.println(c);
        }
}